# KIS Secrets
#
# KOPIEREN: cp .env.example .env
# WICHTIG: .env niemals committen (steht in .gitignore)
#
# Alle Secrets müssen aus ENV-Variablen kommen, nie in config/kis.toml

# --- Server ---
KIS_SERVER_HOST=0.0.0.0
KIS_SERVER_PORT=8080

# --- PostgreSQL ---
KIS_DB_PASSWORD=change-me-in-production
# KIS_DATABASE_WRITE_URL=postgresql://kis:change-me@localhost:5432/kis
# KIS_DATABASE_READ_URL=

# --- Security ---
# JWT-Signaturschlüssel: min. 32 Zeichen, zufällig
# Generieren: openssl rand -base64 48
KIS_JWT_SECRET=change-me-min-32-chars

# AES-256-GCM Master Key: 32 Bytes Base64
# Generieren: openssl rand -base64 32
KIS_MASTER_KEY=change-me-32-bytes-base64

# --- CGM MEDICO (OAuth 2.0 Client Credentials) ---
KIS_MEDICO_BASE_URL=https://fhir.medico.example.com/fhir/
KIS_MEDICO_CLIENT_ID=your-client-id
KIS_MEDICO_CLIENT_SECRET=your-client-secret

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...

# --- Feature-Flags (welche Module aktivieren) ---
# Alle: patients,doctors,appointments,medications,fhir,medico,ui
# Nur MEDICO: medico
KIS_FEATURES=patients,doctors,appointments,medications,fhir,medico,ui
