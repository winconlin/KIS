# KIS — Beispiel-Umgebung. Kopieren: cp .env.example .env && chmod 600 .env
# docker compose liest .env automatisch; für cargo run Variablen exportieren.
# Nur synthetische Testdaten verwenden.

# --- Pflicht-Secrets (Start bricht ohne gültige Werte ab) ---------------
# JWT-Signaturschlüssel, mind. 32 Bytes:   openssl rand -base64 48
KIS_JWT_SECRET=
# AES-256-GCM-Master-Key, genau 32 Bytes Base64:   openssl rand -base64 32
KIS_MASTER_KEY=

# --- PostgreSQL (docker compose) ----------------------------------------
POSTGRES_PASSWORD=
# Schema-Eigentümer (nur Migrationen) und Laufzeitrolle (nur DML)
KIS_OWNER_PASSWORD=
KIS_APP_PASSWORD=

# --- Ohne compose: Verbindungen direkt setzen ---------------------------
# Abschnitte der TOML-Konfiguration werden mit __ getrennt.
# KIS_DATABASE__WRITE_URL=postgres://kis_app:…@localhost:5432/kis
# KIS_DATABASE__MIGRATION_URL=postgres://kis_owner:…@localhost:5432/kis
# KIS_CONFIG=/pfad/zu/kis.toml

# --- TLS (optional; sonst HTTP nur hinter TLS-Proxy oder lokal) ---------
# KIS_TLS_CERT=/etc/kis/tls/server.crt
# KIS_TLS_KEY=/etc/kis/tls/server.key
# Gesetzt = Client-Zertifikat verpflichtend (mTLS):
# KIS_TLS_CA=/etc/kis/tls/clients-ca.pem
