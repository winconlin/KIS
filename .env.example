# Compose liest .env; cargo run lädt diese Datei nicht automatisch.
# cp .env.example .env; chmod 600 .env
# Zufällig generieren: openssl rand -base64 48 bzw. openssl rand -base64 32
KIS_JWT_SECRET=
KIS_MASTER_KEY=

# Für manuellen Start optional explizit exportieren; __ trennt Abschnitte.
# KIS_CONFIG_PATH=config/kis.toml
# KIS_SERVER__HOST=127.0.0.1
# KIS_SERVER__PORT=8080
# KIS_DATABASE__PATH=data/kis.db

# MEDICO-Client ist noch nicht als Importdienst angeschlossen.
# KIS_MEDICO_CLIENT_ID=
# KIS_MEDICO_CLIENT_SECRET=
