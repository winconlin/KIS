# Compose liest .env; cargo run lädt diese Datei nicht automatisch.
# cp .env.example .env; chmod 600 .env
# Zufällig generieren: openssl rand -base64 48 bzw. openssl rand -base64 32

# ============================================================
# KERN-SECRETS (Pflicht)
# ============================================================

# PostgreSQL-Passwort (AES-256-GCM verschlüsselt)
KIS_DB_PASSWORD=

# JWT-Signatur-Secret (HS256, 48 Bytes base64)
# Generieren: openssl rand -base64 48
KIS_JWT_SECRET=

# AES-256-GCM Master Key (32 Bytes base64)
# Generieren: openssl rand -base64 32
# WICHTIG: Nie im Code, nie im Git, nie in Logs
KIS_ENCRYPTION_KEY=

# ============================================================
# TLS-KONFIGURATION (Task 5.1)
# ============================================================

# Pfad zum TLS-Zertifikat (PEM, Chain: Server + Intermediate)
KIS_TLS_CERT=

# Pfad zum TLS-Private Key (PEM)
KIS_TLS_KEY=

# Pfad zur CA-Datei (PEM, optional für mTLS)
KIS_TLS_CA=

# ============================================================
# EXTERNE DIENSTE
# ============================================================

# MEDICO-Client (OAuth 2.0)
# KIS_MEDICO_CLIENT_ID=
# KIS_MEDICO_CLIENT_SECRET=

# OpenRouter-API-Key (LLM-Agent)
# Format: sk-or-...
OPENROUTER_API_KEY=

# ============================================================
# BACKUP (Task 5.12)
# ============================================================

# age-Recipient für Backup-Verschlüsselung
# Generieren: age-keygen
# Backup-Key: AES-256-GCM, 32 Bytes base64
KIS_BACKUP_KEY=
BACKUP_RECIPIENT=

# ============================================================
# OPTIONALE KONFIGURATION
# ============================================================

# Für manuellen Start optional explizit exportieren; __ trennt Abschnitte.
# KIS_CONFIG_PATH=config/kis.toml
# KIS_SERVER__HOST=127.0.0.1
# KIS_SERVER__PORT=8080
# KIS_DATABASE__PATH=data/kis.db

# ============================================================
# SICHERHEITSHINWEISE
# ============================================================

# 1. NIE echte Secrets in .env.example, Git, Logs oder Code
# 2. .env mit chmod 600 schützen
# 3. Secrets regelmäßig rotieren (jährlich)
# 4. Bei Verdacht auf Kompromittierung: Sofort rotieren
# 5. Zugriff auf Secrets nur für autorisierte Personen/Prozesse
